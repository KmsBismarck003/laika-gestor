# Backend Laika Gestor - FastAPI
# Puerto del servidor (el frontend espera localhost:8000)
HOST=0.0.0.0
PORT=8000

# Clave para firmar tokens JWT (cambia en producción)
JWT_SECRET=laika-super-secret-dev

# Ruta de la base SQLite (por defecto ./backend/laika.db)
DATABASE_URL=sqlite:///./backend/laika.db

# Orígenes permitidos (CORS)
CORS_ORIGINS=http://localhost:3020,http://localhost:5173,http://127.0.0.1:3020